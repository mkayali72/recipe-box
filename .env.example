# -----------------------------------------------------------------------------
# Local configuration template for Recipe Box.
# Copy this file to .env before running Docker Compose. Values here are safe
# examples only; use a private local password for real development.
# -----------------------------------------------------------------------------

POSTGRES_DB=recipebox
POSTGRES_USER=recipebox
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://recipebox:change-me@db:5432/recipebox
# Generate your own strong value before using encrypted recipe data. Keep this
# key safe and private: losing it means losing access to encrypted data.
ENCRYPTION_KEY=replace-with-a-long-random-value-later
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development